# Server-side credential for the Gemini API (required for AI analysis).
DECISION_SERVICE_KEY="replace-with-server-credential"

# Public URL of the app (optional, informational).
APP_URL="http://localhost:3000"

# Comma-separated extra browser origins allowed to call the API.
# Only needed when the frontend and API are on DIFFERENT domains.
# Same-domain deployments (frontend + /api on the same Vercel project) need nothing.
CLIENT_ORIGINS=

# --- Optional AI tuning ---
# Models are raced in parallel; the first valid JSON answer wins.
ANALYSIS_MODELS=gemini-3.1-flash-lite,gemini-flash-latest,gemini-3.8-flash
# Per-model timeout in milliseconds (must stay below the function maxDuration).
ANALYSIS_MODEL_TIMEOUT_MS=40000
# 0 disables "thinking", which keeps responses fast enough for serverless limits.
ANALYSIS_THINKING_BUDGET=0

# --- Optional frontend override (build-time) ---
# Leave EMPTY when the API is served from the same domain (the default).
# Only set it when the API lives on another domain, e.g. https://api.example.com
VITE_API_BASE_URL=
