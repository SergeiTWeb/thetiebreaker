DECISION_SERVICE_KEY="replace-with-server-credential"
APP_URL="http://localhost:3000"

# Comma-separated extra browser origins allowed to call the API (optional).
# Example: CLIENT_ORIGINS="https://thetiebreaker.sergeitumanov.com,https://thetiebreaker-open-tips.vercel.app"
CLIENT_ORIGINS=

# Frontend only: overrides the API base URL baked into the build.
